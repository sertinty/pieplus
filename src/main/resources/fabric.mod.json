{
    "schemaVersion": 1,
    "id": "pieplus",
    "version": "${version}",
    "name": "PiePlus 饼图多位数选择",
    "description": "修复 F3 调试饼图里编号大于 9 的切片无法选中的问题。纯客户端。",
    "authors": [
        "sertinty"
    ],
    "contact": {
        "sources": "https://github.com/sertinty/pieplus"
    },
    "license": "MIT",
    "icon": "assets/pieplus/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.sertinty.pieplus.PiePlusClient"
        ]
    },
    "mixins": [
        {
            "config": "pieplus.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~${minecraft_version}",
        "java": ">=25"
    }
}
